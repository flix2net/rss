    "extractor",
    "scraper",
    "gui",
    "no-dependencies",
    "zero-dependency",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flix2net/rss.git"
  },
  "author": "flix2net",
  "bugs": {
